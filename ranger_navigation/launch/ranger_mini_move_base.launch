<?xml version="1.0"?>
<!--
  ranger_mini_move_base.launch

  move_base configuration for the AgileX Ranger Mini 3.0. This mirrors
  husky_navigation/launch/move_base.launch (NavfnROS global planner +
  DWAPlannerROS local planner over layered costmaps) with the footprint,
  velocity and inflation parameters adapted to the Ranger Mini, and the I/O
  wired to the Ranger base topics (/cmd_vel, /odom).

  Like Husky's move_base.launch this starts ONLY move_base, NOT the base
  driver, a map server, localization or any sensors. To actually move the
  robot you also need (see README.md):
    1. ranger_bringup running with publish_odom_tf:=true   (odom -> base_link)
    2. a /map and a map -> odom transform (map_server + amcl, or for a quick
       no-amcl test a static identity map -> odom transform)
  The ranger_mini_move_base_demo.launch in this package wires 2. up for you.
-->
<launch>

  <arg name="no_static_map" default="false"/>

  <arg name="base_global_planner" default="navfn/NavfnROS"/>
  <arg name="base_local_planner" default="dwa_local_planner/DWAPlannerROS"/>
  <!-- <arg name="base_local_planner" default="base_local_planner/TrajectoryPlannerROS"/> -->

  <!-- The Ranger base node subscribes to /cmd_vel directly (no twist_mux). -->
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="odom_topic" default="/odom"/>

  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">

    <param name="base_global_planner" value="$(arg base_global_planner)"/>
    <param name="base_local_planner" value="$(arg base_local_planner)"/>
    <rosparam file="$(find ranger_navigation)/config/planner.yaml" command="load"/>

    <!-- observation sources located in costmap_common.yaml -->
    <rosparam file="$(find ranger_navigation)/config/costmap_common.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find ranger_navigation)/config/costmap_common.yaml" command="load" ns="local_costmap" />

    <!-- local costmap, needs size -->
    <rosparam file="$(find ranger_navigation)/config/costmap_local.yaml" command="load" ns="local_costmap" />
    <param name="local_costmap/width" value="10.0"/>
    <param name="local_costmap/height" value="10.0"/>

    <!-- static global costmap, static map provides size -->
    <rosparam file="$(find ranger_navigation)/config/costmap_global_static.yaml" command="load" ns="global_costmap" unless="$(arg no_static_map)"/>

    <!-- global costmap with laser, for the mapless demo -->
    <rosparam file="$(find ranger_navigation)/config/costmap_global_laser.yaml" command="load" ns="global_costmap" if="$(arg no_static_map)"/>
    <param name="global_costmap/width" value="100.0" if="$(arg no_static_map)"/>
    <param name="global_costmap/height" value="100.0" if="$(arg no_static_map)"/>

    <!-- wire move_base I/O to the Ranger base topics -->
    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
    <remap from="odom" to="$(arg odom_topic)"/>
  </node>

</launch>
