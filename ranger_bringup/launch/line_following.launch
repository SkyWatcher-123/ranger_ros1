<launch>
  <!-- ================================================================= -->
  <!-- Yellow-tape line following for the Ranger Mini.                    -->
  <!--                                                                   -->
  <!--   loc_camera image ->[tape_line_detector]-> /ranger/tape          -->
  <!--   /ranger/set_base_x (srv) ->[go_to_base_x]-> /ranger/cmd_vel_in  -->
  <!--   /ranger/tape + /ranger/cmd_vel_in ->[line_keeper]-> /cmd_vel    -->
  <!--                                                                   -->
  <!-- Requires apriltag_to_ranger_joint_state.launch running too, so    -->
  <!-- TF map->base_link exists (go_to_base_x reads current X from it).  -->
  <!-- Run EITHER go_to_base_x OR manual teleop into /ranger/cmd_vel_in. -->
  <!-- ================================================================= -->

  <arg name="base_frame"  default="base_link"/>
  <arg name="map_frame"   default="map"/>
  <arg name="base_height" default="0.346"/>

  <arg name="image_topic"       default="/loc_camera/color/image_raw"/>
  <arg name="camera_info_topic" default="/loc_camera/color/camera_info"/>

  <arg name="travel_speed" default="0.1"/>   <!-- strict uniform m/s -->
  <arg name="tolerance"    default="0.03"/>  <!-- go-to-X longitudinal stop tolerance, 2-5 cm -->
  <arg name="lateral_tolerance" default="0.03"/>  <!-- allowed left/right drift band [m]; live-tunable -->
  <arg name="live_tune"    default="true"/>  <!-- re-read gains/tolerance mid-run via rosparam set -->

  <!-- ==== Tape detector: image to /ranger/tape (metric BEV line fit) ==== -->
  <node pkg="ranger_bringup" type="tape_line_detector.py" name="tape_line_detector" output="screen">
    <remap from="~tape"         to="/ranger/tape"/>
    <remap from="~debug_image"  to="/ranger/tape_debug"/>
    <remap from="~set_reference" to="/ranger/tape/set_reference"/>

    <param name="base_frame"        value="$(arg base_frame)"/>
    <param name="base_height"       value="$(arg base_height)"/>
    <param name="image_topic"       value="$(arg image_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>

    <!-- BEV window (metric); defaults match the measured 45deg-down footprint -->
    <param name="bev_x_near" value="0.55"/>
    <param name="bev_x_far"  value="1.20"/>
    <param name="bev_y_right" value="-0.55"/>
    <param name="bev_y_left"  value="0.35"/>
    <param name="bev_pixels_per_meter" value="300.0"/>
    <param name="x_lookahead" value="0.80"/>

    <!-- Yellow HSV gate (OpenCV H 0..179). Tune with /ranger/tape_debug. -->
    <param name="h_lo" value="20"/>  <param name="h_hi" value="40"/>
    <param name="s_lo" value="80"/>  <param name="s_hi" value="255"/>
    <param name="v_lo" value="80"/>  <param name="v_hi" value="255"/>

    <param name="min_pixels"     value="300"/>
    <param name="ransac_thresh_m" value="0.02"/>
    <param name="smooth_alpha"   value="0.5"/>
    <param name="publish_debug"  value="true"/>
  </node>

  <!-- ==== Line keeper: (/ranger/tape, /ranger/cmd_vel_in) to /cmd_vel ==== -->
  <node pkg="ranger_bringup" type="line_keeper.py" name="line_keeper" output="screen">
    <remap from="~tape"        to="/ranger/tape"/>
    <remap from="~cmd_vel_in"  to="/ranger/cmd_vel_in"/>
    <remap from="~cmd_vel_out" to="/cmd_vel"/>

    <param name="k_heading" value="1.2"/>
    <param name="k_cross"   value="1.5"/>
    <param name="sign"      value="1.0"/>
    <param name="max_wz"    value="0.4"/>
    <param name="wz_slew"   value="1.5"/>
    <param name="max_speed" value="$(arg travel_speed)"/>
    <param name="v_min"     value="0.02"/>
    <param name="deadband_ct" value="$(arg lateral_tolerance)"/>  <!-- allowed lateral drift band -->
    <param name="deadband_hd" value="0.0087"/>
    <param name="rate"          value="20.0"/>
    <param name="tape_timeout"  value="0.4"/>
    <param name="min_confidence" value="0.3"/>
    <param name="stop_on_tape_loss" value="true"/>
    <param name="live_reconfig" value="$(arg live_tune)"/>
    <param name="reconfig_period" value="0.5"/>
    <param name="stats_period"  value="2.0"/>   <!-- log achieved lateral rms/max every 2 s -->
  </node>

  <!-- ==== Go-to-X: SetBaseX service, strict +/-0.1 m/s travel ==== -->
  <node pkg="ranger_bringup" type="go_to_base_x.py" name="go_to_base_x" output="screen">
    <remap from="~cmd_vel_out" to="/ranger/cmd_vel_in"/>
    <remap from="~set_base_x"  to="/ranger/set_base_x"/>
    <remap from="~at_target"   to="/ranger/at_target_x"/>
    <remap from="~x_error"     to="/ranger/base_x_error"/>

    <param name="map_frame"  value="$(arg map_frame)"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="speed"      value="$(arg travel_speed)"/>
    <param name="default_tolerance" value="$(arg tolerance)"/>
    <param name="rate" value="20.0"/>
  </node>
</launch>
