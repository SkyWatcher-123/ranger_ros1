Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /TapeLines1
        - /TapeBEVDebug1
      Splitter Ratio: 0.5
    Tree Height: 640
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 160; 160; 164
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Frames:
        All Enabled: true
      Marker Scale: 0.4
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Frame Timeout: 15
      Value: true
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description
      TF Prefix: ""
      Collision Enabled: false
      Visual Enabled: true
      Update Interval: 0
      Value: true
    - Class: rviz/MarkerArray
      Name: TapeLines
      Enabled: true
      Marker Topic: /ranger/tape_markers
      Namespaces: {}
      Queue Size: 100
      Value: true
    - Class: rviz/Image
      Name: TapeBEVDebug
      Enabled: true
      Image Topic: /ranger/tape_debug
      Transport Hint: raw
      Queue Size: 2
      Max Value: 1
      Min Value: 0
      Normalize Range: true
      Median window: 5
      Unreliable: false
      Value: true
    - Class: rviz/Image
      Name: LocCameraRaw
      Enabled: true
      Image Topic: /loc_camera/color/image_raw
      Transport Hint: raw
      Queue Size: 2
      Max Value: 1
      Min Value: 0
      Normalize Range: true
      Median window: 5
      Unreliable: false
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Distance: 4.0
      Focal Point:
        X: 3.0
        Y: 1.2
        Z: 0.0
      Pitch: 0.75
      Yaw: 3.7
      Target Frame: base_link
      Near Clip Distance: 0.01
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Hide Left Dock: false
  Hide Right Dock: false
